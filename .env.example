# --- Required ---
DOMAIN=pugs.example.com                 # Caddy obtains TLS automatically
PUBLIC_URL=https://pugs.example.com     # Used for OAuth redirects and Discord links
SESSION_SECRET=                         # >= 32 random chars: openssl rand -hex 32
POSTGRES_PASSWORD=                      # Database password

# --- Discord (login + bot) ---
DISCORD_CLIENT_ID=                      # OAuth2 app id; redirect URI: $PUBLIC_URL/api/auth/discord/callback
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=                      # Optional; enables slash commands + notifications
DISCORD_GUILD_ID=                       # Optional; registers commands to one guild instantly
OWNER_DISCORD_IDS=                      # Comma-separated Discord user IDs that become OWNER on first login

# --- Deadlock API ---
DEADLOCK_API_URL=https://api.deadlock-api.com
DEADLOCK_ASSETS_URL=https://assets.deadlock-api.com
DEADLOCK_API_KEY=                       # Optional; higher rate limits. Never exposed to the browser.
LIVE_EVENTS_URL=                        # e.g. http://live-events:3000 (docker compose --profile live)
PUBLIC_LIVE_DELAY_SEC=120               # Public scoreboard delay (competitive integrity)

# --- Development ---
SIMULATION_MODE=false                   # true enables dev login + simulator; data is flagged, never rated in real seasons
